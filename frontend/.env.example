# AI-KART Frontend — Environment Variables
# Copy to .env.local and fill in values

# Backend API base URL (leave empty to use Vite proxy, set for production)
VITE_API_BASE_URL=

# Hub server origin (e.g. https://192.168.1.10:8484)
# Leave empty to disable widget injection (orb renders in idle-only mode)
VITE_SHOPBOT_HUB_ORIGIN=http://143.198.5.97/aihub

# Site identifier sent to the hub
VITE_SHOPBOT_SITE_ID=ai_kart_main
