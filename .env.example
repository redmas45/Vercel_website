# Clone source and build settings
SOURCE_URL=https://demo.vercel.store/
MIRROR_DIR=out
MAX_PAGES=80
MAX_ASSETS=300
CRAWL_CONCURRENCY=6
REQUEST_TIMEOUT_MS=20000
USER_AGENT=vercel-store-lab/1.0

# Public catalog API
API_CORS_ORIGIN=*

# ShopBot same-origin proxy
SHOPBOT_BACKEND_URL=https://d962-103-97-243-133.ngrok-free.app
SHOPBOT_SITE_ID=https_demo_vercel_store

# Image compatibility proxy
IMAGE_PROXY_ALLOWED_HOSTS=cdn.shopify.com demo.vercel.store vercel.com assets.vercel.com

# Lab injection master switch
LAB_INJECTION_ENABLED=true
LAB_INJECTION_POSITION=body
LAB_SECURITY_MODE=lab
LAB_ALLOWED_SCRIPT_ORIGINS=

# Mode A: inject one raw HTML tag, e.g. a script tag with data attributes.
LAB_INJECTION_HTML=

# Mode B: inject a script by src. Used only when LAB_INJECTION_HTML is empty.
LAB_INJECTION_SRC=/lab/injection.js

# Mode C: server-side remote script proxy. Set LAB_INJECTION_SRC=/lab/remote.js.
LAB_REMOTE_SCRIPT_URL=
LAB_REMOTE_SCRIPT_KEY=
LAB_REMOTE_SCRIPT_KEY_HEADER=X-Lab-Api-Key

# Mode D: inject raw JavaScript code. Used only when HTML/SRC are empty.
LAB_INJECTION_CODE=
LAB_INJECTION_CODE_BASE64=
