PUBLIC_BASE_URL=https://vercelclonedwebsite.vercel.app

# Give callers LAB_ACCESS_KEY. Store only LAB_ACCESS_KEY_SHA256 in Vercel.
LAB_ACCESS_KEY=replace_with_raw_key
LAB_ACCESS_KEY_SHA256=replace_with_sha256_of_raw_key

# Both URLs use the same access key.
CATALOG_BASE_URL=https://vercelclonedwebsite.vercel.app
CATALOG_API_URL=https://vercelclonedwebsite.vercel.app/api/products?key=replace_with_raw_key
SHOPBOT_ENTRY_URL=https://vercelclonedwebsite.vercel.app/api/shopbot.js?key=replace_with_raw_key

SHOPBOT_SITE_ID=https_demo_vercel_store

# Primary widget delivery path for this cloned site.
# Update the script URL and allowed origin each backend session.
LAB_INJECTION_ENABLED=true
LAB_INJECTION_HTML=<script src="https://fresh-tunnel-url.example.com/shopbot.js?site=https_demo_vercel_store"></script>
LAB_ALLOWED_SCRIPT_ORIGINS=https://fresh-tunnel-url.example.com
LAB_INJECTION_SRC=
LAB_INJECTION_CODE=
LAB_INJECTION_CODE_BASE64=

# Legacy backend proxy support remains in code but is not the primary widget path.
# SHOPBOT_BACKEND_URL=https://your-backend.example.com

API_CORS_ORIGIN=*
IMAGE_PROXY_ALLOWED_HOSTS=cdn.shopify.com demo.vercel.store vercel.com assets.vercel.com
