SOURCE_URL=https://demo.vercel.store/
MIRROR_DIR=out
MAX_PAGES=80
MAX_ASSETS=300
CRAWL_CONCURRENCY=6
REQUEST_TIMEOUT_MS=20000
USER_AGENT=vercel-store-lab/1.0

# Use this for plug-and-play JS injection from another project.
# Example: LAB_INJECTION_SRC=https://your-other-project.vercel.app/inject.js
LAB_INJECTION_ENABLED=true
LAB_INJECTION_SRC=/lab/injection.js

# Safer server-side remote mode:
# Set LAB_INJECTION_SRC=/lab/remote.js, then configure these.
# Your other project should require the same key in the X-Lab-Api-Key header.
LAB_REMOTE_SCRIPT_URL=
LAB_REMOTE_SCRIPT_KEY=
LAB_REMOTE_SCRIPT_KEY_HEADER=X-Lab-Api-Key

# Alternative: put raw one-line JavaScript here.
LAB_INJECTION_CODE=

# Alternative: base64-encode a full script and put it here.
LAB_INJECTION_CODE_BASE64=

# "lab" permits inline/eval for practice. "strict" blocks inline script by CSP.
LAB_SECURITY_MODE=lab
LAB_INJECTION_POSITION=body

# Add script origins when LAB_INJECTION_SRC points to another domain.
# Example: LAB_ALLOWED_SCRIPT_ORIGINS=https://your-other-project.vercel.app
LAB_ALLOWED_SCRIPT_ORIGINS=

# Hosts allowed through the /_next/image compatibility proxy.
IMAGE_PROXY_ALLOWED_HOSTS=cdn.shopify.com demo.vercel.store vercel.com assets.vercel.com

# Public JSON catalog API CORS. Use * for open access.
API_CORS_ORIGIN=*
