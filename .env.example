PUBLIC_BASE_URL=http://127.0.0.1:8584

# Give callers LAB_ACCESS_KEY. Store only LAB_ACCESS_KEY_SHA256 in backend.
LAB_ACCESS_KEY=replace_with_raw_key
LAB_ACCESS_KEY_SHA256=replace_with_sha256_of_raw_key

# Share this keyed catalog URL with trusted lab clients.
CATALOG_BASE_URL=http://127.0.0.1:8584
CATALOG_API_URL=http://127.0.0.1:8584/api/products?key=replace_with_raw_key

# Inject this external script tag into every page <head>.
# Update both values each backend session.
LAB_INJECTION_HTML=<script src="http://127.0.0.1:8585/shopbot.js?site=ai_kart_main"></script>
LAB_ALLOWED_SCRIPT_ORIGINS=http://127.0.0.1:8585

API_CORS_ORIGIN=*
IMAGE_PROXY_ALLOWED_HOSTS=cdn.shopify.com demo.vercel.store vercel.com assets.vercel.com
