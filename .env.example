DATABASE_URL=postgres://USER:PASS@127.0.0.1:5432/demo_clone
SOURCE_URL=https://demo.vercel.store/
MIRROR_DIR=out
MAX_PAGES=200
MAX_ASSETS=500
CRAWL_CONCURRENCY=6
REQUEST_TIMEOUT_MS=20000
ALLOWED_MIME_REGEX=text\/html|text\/css|application\/javascript|image\/|font|audio|video|application\/json
USER_AGENT=lab-crawler/1.0 (+local security lab)
