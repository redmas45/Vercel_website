# AI-KART Backend — Environment Variables
# Copy to .env and fill in values

# Database (default: local SQLite file, swap connection string for Postgres)
DATABASE_URL=sqlite+aiosqlite:///./aikart.db

# CORS — comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://143.198.5.97

# Additional script origins for the Content-Security-Policy (space-separated)
LAB_ALLOWED_SCRIPT_ORIGINS=http://143.198.5.97

# Set this if the backend is served behind HTTPS in production
PUBLIC_HTTPS_ORIGIN=

# Local storefront admin bootstrap
AUTH_SECRET_KEY=change-me
DEFAULT_ADMIN_EMAIL=admin@aikart.local
DEFAULT_ADMIN_PASSWORD=change_this_admin_password
UPLOAD_DIR=static/uploads
